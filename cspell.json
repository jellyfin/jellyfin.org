{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en, en-US, en-GB",
  "allowCompoundWords": true,
  "files": ["**/*.md", "**/*.mdx", "src/**/*.tsx"],
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./styles/config/vocabularies/Jellyfin/accept.txt",
      "addWords": true
    },
    {
      "name": "project-brands",
      "description": "Brands covered by Jellyfin.Terms. Keep these cSpell-only: adding them to Vale's shared vocabulary can suppress capitalization warnings.",
      "words": [
        "AMD",
        "AniDB",
        "AniList",
        "Android",
        "Apache",
        "Apple",
        "ArchLinux",
        "Armbian",
        "Asahi",
        "Caddy",
        "Certbot",
        "Chrome",
        "Chromecast",
        "Cloudflare",
        "Debian",
        "Docker",
        "Docusaurus",
        "FFmpeg",
        "Firefox",
        "FreeBSD",
        "GitHub",
        "GitLab",
        "Google",
        "HAProxy",
        "HDHomeRun",
        "Intel",
        "iOS",
        "Jellyfin",
        "JetBrains",
        "Kodi",
        "Kubernetes",
        "LetsEncrypt",
        "LinuxServer",
        "macOS",
        "Microsoft",
        "Mopidy",
        "nginx",
        "NVIDIA",
        "OMDb",
        "openSUSE",
        "Plex",
        "Podman",
        "PowerShell",
        "Proxmox",
        "Radeon",
        "Raspbian",
        "Rockchip",
        "Roku",
        "RPMFusion",
        "SELinux",
        "Safari",
        "Shoutcast",
        "Swiftfin",
        "Synology",
        "Tailscale",
        "TMDB",
        "Traefik",
        "TrueNAS",
        "TVDB",
        "Tvheadend",
        "tvOS",
        "Ubuntu",
        "VideoToolbox",
        "Vue",
        "Vulkan",
        "webOS",
        "WebStorm",
        "Windows",
        "WireGuard",
        "YouTube"
      ]
    }
  ],
  "dictionaries": ["project-words", "project-brands"],
  "ignorePaths": [
    "node_modules",
    "/styles/config/vocabularies/Jellyfin/accept.txt",
    "/src/components/common/PlatformIcon.tsx",

    "/blog/2019/*",
    "/blog/2020/*",
    "/blog/2021/*",
    "/blog/2022/*",
    "/blog/2023/*",
    "/blog/2024/*",
    "/blog/2025/*"
  ]
}
